{
  "name": "probative",
  "version": "0.1.0",
  "description": "Turn a Node.js repository into a reproducible, source-linked CRA technical evidence pack. Prepares technical evidence; never claims legal compliance.",
  "type": "module",
  "bin": {
    "probative": "bin/probative.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "bin",
    "src",
    "rules",
    "schemas",
    "reference",
    "SKILL.md",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test \"test/unit/*.test.mjs\" \"test/integration/*.test.mjs\"",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "test:integration": "node --test \"test/integration/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=94 --test-coverage-branches=82 --test-coverage-functions=95 \"test/unit/*.test.mjs\" \"test/integration/*.test.mjs\"",
    "selfcheck": "node bin/probative.mjs inspect . --json",
    "fixtures": "node test/build-fixtures.mjs",
    "docs": "node scripts/generate-coverage-doc.mjs",
    "check:upstream": "node scripts/check-upstream.mjs"
  },
  "keywords": [
    "cra",
    "cyber-resilience-act",
    "sbom",
    "cyclonedx",
    "compliance-evidence",
    "eu"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeharengOlivier/probative.git"
  },
  "homepage": "https://github.com/DeharengOlivier/probative#readme",
  "bugs": {
    "url": "https://github.com/DeharengOlivier/probative/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {},
  "devDependencies": {}
}
